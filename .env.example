# Project Environment Configuration Example
PROJECT_NAME="Lost & Found Matching System"
SECRET_KEY="super-secret-jwt-key-change-in-production-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite for easy setup)
# For PostgreSQL: postgresql://user:password@localhost:5432/lost_found_db
DATABASE_URL="sqlite:///./lost_found.db"

# Matching Engine Weight Configuration
WEIGHT_LOCATION=0.20
WEIGHT_CATEGORY=0.15
WEIGHT_ITEM_NAME=0.15
WEIGHT_BRAND=0.15
WEIGHT_TIME=0.15
WEIGHT_COLOR=0.10
WEIGHT_DESCRIPTION=0.10
